{
  "name": "noyoutubeshorts",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Don't Watch YouTube Shorts! - Cross-browser extension",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt --browser firefox",
    "build": "wxt build",
    "build:firefox": "wxt build --browser firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip --browser firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@wxt-dev/module-svelte": "^2.0.5",
    "@wxt-dev/storage": "^1.2.8",
    "svelte": "^5.55.1",
    "tailwindcss": "^4.2.2",
    "wxt": "^0.20.20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "typescript": "^6.0.2"
  }
}
